{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App: Run backend",
      "type": "shell",
      "command": "C:\\xampp\\php\\php.exe",
      "args": [
        "-c",
        "${workspaceFolder}\\Backend\\API\\php.ini",
        "-S",
        "localhost:8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\Backend\\API",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "App: Run frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "App: Run backend and frontend",
      "dependsOn": [
        "App: Run backend",
        "App: Run frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
