{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App: Run backend",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build",
        "api"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "App: Stop backend",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "App: Run frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "App: Run backend and frontend",
      "dependsOn": [
        "App: Run backend",
        "App: Run frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
